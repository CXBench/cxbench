# Copy to .env and set your private OpenAI API key. Never commit .env.
OPENAI_API_KEY=replace_with_openai_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_WIRE_API=responses
OPENAI_RESPONSES_STREAM=true
OPENAI_REASONING_EFFORT=low
OPENAI_MAX_OUTPUT_TOKENS=8192

# Request transport controls (separate from task/judge execution retries).
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=5
OPENAI_RETRY_BACKOFF_SECONDS=2
OPENAI_VALIDATION_RETRIES=1
