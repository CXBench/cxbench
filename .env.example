# Copy this file to .env and replace only the credential values you use.
# The repository-level runner loads all provider profiles from the same file.

# CRS: Responses API by default.
CRS_OAI_KEY=replace_with_crs_key
CRS_OAI_BASE_URL=https://crs.uuid.im/openai/v1
CRS_OAI_WIRE_API=responses
CRS_OAI_RESPONSES_STREAM=true

# Shubiaobiao: OpenAI-compatible Chat Completions API.
SHUBIAOBIAO_API_KEY=replace_with_shubiaobiao_key
SHUBIAOBIAO_BASE_URL=https://api.shubiaobiao.cn/v1
SHUBIAOBIAO_WIRE_API=chat

# OpenRouter: keep the base URL explicit because --agent-provider openrouter
# routes the bare agent model through the generic OpenAI-compatible client.
OPENROUTER_API_KEY=replace_with_openrouter_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_WIRE_API=chat

# Shared transport controls.
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_RETRIES=5
OPENAI_RETRY_BACKOFF_SECONDS=2
OPENAI_VALIDATION_RETRIES=1
